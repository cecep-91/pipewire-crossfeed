# crossfeed.conf.in — template for the installed crossfeed PipeWire conf.
#
# The @GAIN2@ / @DIR_GAIN@ / @FREQ@ placeholders are filled in with your
# saved level/frequency/on-off state by install.sh, the GUI and the
# crossfeed-ab toggle on every change, and the result is written to
# ~/.config/pipewire/pipewire.conf.d/crossfeed.conf. That way PipeWire
# always comes back up in your last state after a restart or reboot — no
# restore service, no init-system involvement. Don't edit the rendered file
# by hand; it's overwritten on every settings change.
#
# The main PipeWire daemon reads pipewire.conf.d/ drop-ins on every distro,
# so this works the same whether or not filter-chain.service exists, and
# the same on systemd and non-systemd systems.
#
# Topology — two nodes:
#   - "crossfeed" (shown as "Crossfeed"): a plain null sink. Shows up as a
#     normal output device everywhere — pick it as your system output, or as
#     an effects app's (EasyEffects, JamesDSP, ...) output device if you
#     chain one in front.
#   - "crossfeed_sink"/"crossfeed_out": a filter-chain that taps the null
#     sink's monitor, applies the crossfeed graph, and plays the result to
#     your real default device (@DEFAULT_SINK@). The GUI/toggle tools look
#     the DSP node up by the name "crossfeed_sink".
#
# Chain (no effects app): apps -> Crossfeed (null sink) -> DSP -> default output.
# Chain (with EasyEffects): apps -> EasyEffects -> Crossfeed -> DSP -> default output.
#
# IMPORTANT: do NOT set "Crossfeed" as your system default output. Leave the
# system default on your real device — the DSP plays to @DEFAULT_SINK@, so
# pointing the default at Crossfeed itself creates a feedback loop (audible
# as rapid clicking/stutter). Select Crossfeed as an individual app's or
# effects app's output device instead, never as the system default.

context.objects = [
  { factory = adapter
    args = {
      factory.name     = support.null-audio-sink
      node.name        = "crossfeed"
      node.description = "Crossfeed"
      media.class      = Audio/Sink
      audio.position   = [ FL FR ]
    }
  }
]

context.modules = [
  { name = libpipewire-module-filter-chain
    args = {
      node.description = "Crossfeed DSP"
      media.name        = "Crossfeed DSP"
      filter.graph = {
        nodes = [
          { type = builtin label = copy       name = inL }
          { type = builtin label = copy       name = inR }
          { type = builtin label = bq_lowshelf name = dirL control = { "Freq" = @FREQ@ "Q" = 0.7 "Gain" = @DIR_GAIN@ } }
          { type = builtin label = bq_lowshelf name = dirR control = { "Freq" = @FREQ@ "Q" = 0.7 "Gain" = @DIR_GAIN@ } }
          { type = builtin label = bq_lowpass  name = xL   control = { "Freq" = @FREQ@ "Q" = 0.5 } }
          { type = builtin label = bq_lowpass  name = xR   control = { "Freq" = @FREQ@ "Q" = 0.5 } }
          { type = builtin label = mixer name = outL control = { "Gain 1" = 1.0 "Gain 2" = @GAIN2@ } }
          { type = builtin label = mixer name = outR control = { "Gain 1" = 1.0 "Gain 2" = @GAIN2@ } }
        ]
        links = [
          { output = "inL:Out" input = "dirL:In" }
          { output = "inR:Out" input = "dirR:In" }
          { output = "inL:Out" input = "xL:In" }
          { output = "inR:Out" input = "xR:In" }
          { output = "dirL:Out" input = "outL:In 1" }
          { output = "xR:Out"   input = "outL:In 2" }
          { output = "dirR:Out" input = "outR:In 1" }
          { output = "xL:Out"   input = "outR:In 2" }
        ]
        inputs  = [ "inL:In" "inR:In" ]
        outputs = [ "outL:Out" "outR:Out" ]
      }
      capture.props  = {
        node.name           = "crossfeed_sink"
        target.object       = "crossfeed"
        stream.capture.sink = true
        audio.position      = [ FL FR ]
      }
      playback.props = {
        node.name      = "crossfeed_out"
        node.passive   = true
        audio.position = [ FL FR ]
        target.object  = "@DEFAULT_SINK@"
      }
    }
  }
]
